{
  "outputDirectory": ".",
  "routes": [
    {
      "src": "/(galeriaimagens|assets/images|images)/(.*)\\.png",
      "status": 308,
      "headers": {
        "Location": "/$1/$2.jpg",
        "Cache-Control": "public, max-age=86400"
      }
    },
    {
      "src": "/(galeriaimagens|assets/images|images)/(.*)\\.(jpg|webp)",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      },
      "continue": true
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/cabana-invisivel",
      "dest": "/cabana-invisivel/index.html"
    },
    {
      "src": "/cabana-invisivel/",
      "dest": "/cabana-invisivel/index.html"
    },
    {
      "src": "/cabana-we",
      "dest": "/cabana-we/index.html"
    },
    {
      "src": "/cabana-we/",
      "dest": "/cabana-we/index.html"
    },
    {
      "src": "/cabana-da-arvore",
      "dest": "/cabana-da-arvore/index.html"
    },
    {
      "src": "/cabana-da-arvore/",
      "dest": "/cabana-da-arvore/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
